{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "0.3.1",
  "description": "Round 03.1 — Encoding presets & hardware guardrails for Apple-inspired Video Editing Portfolio",
  "hardwarePolicy": {
    "targetProfile": "Mac Intel Core i7 (6C/12T) · 16 GB RAM",
    "defaultConcurrency": 1,
    "maxConcurrency": 1,
    "defaultFfmpegThreads": 6,
    "minFreeMemoryMb": 1024,
    "warnMemoryMb": 2048,
    "note": "Runs strictly 1 FFmpeg encode job at a time by default to prevent thermal throttling and memory pressure on 16 GB Intel Macs."
  },
  "inspectionThresholds": {
    "webStandardMaxBitrateKbps": 8500,
    "webHighQualityMaxBitrateKbps": 16500,
    "hoverPreviewMaxSizeBytes": 2097152,
    "heroAmbientMaxSizeBytes": 6291456,
    "posterMaxSizeBytes": 358400
  },
  "presets": {
    "poster": {
      "id": "poster",
      "kind": "image",
      "description": "Still frame poster in WebP format. Always loaded before any video or preview.",
      "container": "webp",
      "ext": ".webp",
      "mimeType": "image/webp",
      "videoCodec": "libwebp",
      "quality": 82,
      "compressionLevel": 6,
      "seekPercent": 0.15,
      "maxDimensions": {
        "landscape": { "width": 1600, "height": 900 },
        "portrait": { "width": 900, "height": 1600 }
      },
      "upscale": false,
      "deliveryLayer": "pages",
      "cacheControl": "public, max-age=31536000, immutable"
    },
    "hover-preview": {
      "id": "hover-preview",
      "kind": "video",
      "description": "Short muted MP4 loop (3–8s) sized for gallery cards. Never preloaded eagerly; triggered only on fine-pointer hover.",
      "container": "mp4",
      "ext": ".mp4",
      "mimeType": "video/mp4",
      "videoCodec": "libx264",
      "profile": "main",
      "level": "3.1",
      "pixFmt": "yuv420p",
      "crf": 24,
      "crfRange": [22, 27],
      "x264Preset": "medium",
      "tune": "film",
      "aqMode": 3,
      "aqStrength": 0.8,
      "maxrateKbps": 1400,
      "bufsizeKbps": 2800,
      "audio": false,
      "faststart": true,
      "durationSec": { "min": 3, "default": 5, "max": 8 },
      "seekPercent": 0.2,
      "maxDimensions": {
        "landscape": { "width": 960, "height": 540 },
        "portrait": { "width": 540, "height": 960 }
      },
      "upscale": false,
      "preserveFps": true,
      "hdrPolicy": "require-tonemap-or-review",
      "deliveryLayer": "r2",
      "cacheControl": "public, max-age=31536000, immutable"
    },
    "hero-ambient": {
      "id": "hero-ambient",
      "kind": "video",
      "description": "Lightweight muted ambient loop (6–10s) for fullscreen hero stage with poster fallback.",
      "container": "mp4",
      "ext": ".mp4",
      "mimeType": "video/mp4",
      "videoCodec": "libx264",
      "profile": "high",
      "level": "4.1",
      "pixFmt": "yuv420p",
      "crf": 22,
      "crfRange": [20, 24],
      "x264Preset": "slow",
      "aqMode": 3,
      "aqStrength": 0.8,
      "maxrateKbps": 4200,
      "bufsizeKbps": 8400,
      "audio": false,
      "faststart": true,
      "durationSec": { "min": 5, "default": 8, "max": 12 },
      "seekPercent": 0.15,
      "maxDimensions": {
        "landscape": { "width": 1920, "height": 1080 },
        "portrait": { "width": 1080, "height": 1920 }
      },
      "upscale": false,
      "preserveFps": true,
      "hdrPolicy": "require-tonemap-or-review",
      "deliveryLayer": "r2",
      "cacheControl": "public, max-age=31536000, immutable"
    },
    "web-standard": {
      "id": "web-standard",
      "kind": "video",
      "description": "Balanced full-length web playback MP4 (1080p max, H.264 High@4.1, AAC 160k, faststart) for universal browser & iPhone/Safari compatibility.",
      "container": "mp4",
      "ext": ".mp4",
      "mimeType": "video/mp4",
      "videoCodec": "libx264",
      "profile": "high",
      "level": "4.1",
      "pixFmt": "yuv420p",
      "crf": 20,
      "crfRange": [18, 23],
      "x264Preset": "slow",
      "aqMode": 3,
      "aqStrength": 0.8,
      "maxrateKbps": 8000,
      "bufsizeKbps": 16000,
      "audio": true,
      "audioCodec": "aac",
      "audioBitrateKbps": 160,
      "audioSampleRate": 48000,
      "audioChannels": 2,
      "faststart": true,
      "maxDimensions": {
        "landscape": { "width": 1920, "height": 1080 },
        "portrait": { "width": 1080, "height": 1920 }
      },
      "upscale": false,
      "preserveFps": true,
      "hdrPolicy": "require-tonemap-or-review",
      "deliveryLayer": "r2",
      "cacheControl": "public, max-age=31536000, immutable"
    },
    "web-high-quality": {
      "id": "web-high-quality",
      "kind": "video",
      "description": "Showcase-grade full playback MP4 (up to 1440p without upscaling, CRF 18, dark-scene variance AQ, AAC 192k, faststart) for hero films and color-critical cuts.",
      "container": "mp4",
      "ext": ".mp4",
      "mimeType": "video/mp4",
      "videoCodec": "libx264",
      "profile": "high",
      "level": "5.1",
      "pixFmt": "yuv420p",
      "crf": 18,
      "crfRange": [16, 20],
      "x264Preset": "slow",
      "aqMode": 3,
      "aqStrength": 0.85,
      "maxrateKbps": 16000,
      "bufsizeKbps": 32000,
      "audio": true,
      "audioCodec": "aac",
      "audioBitrateKbps": 192,
      "audioSampleRate": 48000,
      "audioChannels": 2,
      "faststart": true,
      "maxDimensions": {
        "landscape": { "width": 2560, "height": 1440 },
        "portrait": { "width": 1440, "height": 2560 }
      },
      "upscale": false,
      "preserveFps": true,
      "hdrPolicy": "require-tonemap-or-review",
      "deliveryLayer": "r2",
      "cacheControl": "public, max-age=31536000, immutable"
    }
  }
}

