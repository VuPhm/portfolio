# Round 03.1 — Portfolio & Cloudflare R2 Environment Template
# Copy to `.env` locally when needed. NEVER commit `.env` or secret keys to Git.

# Demo preview mode (set to "true" only when previewing sample/demo entries locally)
PUBLIC_DEMO_PREVIEW=false

# Public custom domain connected to Cloudflare R2 bucket (zero egress cost via Cloudflare)
PUBLIC_MEDIA_BASE_URL=https://media.example.com

# Cloudflare R2 credentials (used ONLY by local CLI scripts when you explicitly run rclone/wrangler; never bundled in client code)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=portfolio-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

