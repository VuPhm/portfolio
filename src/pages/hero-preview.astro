---
import BaseLayout from '../layouts/BaseLayout.astro';
import CinematicStage from '../components/CinematicStage.astro';
import CollectionCard from '../components/CollectionCard.astro';
import EditorialVideoGrid from '../components/EditorialVideoGrid.astro';
import EmptyState from '../components/EmptyState.astro';
import GoogleDriveButton from '../components/GoogleDriveButton.astro';
import { siteConfig, hasRealContactEmail, isRealSocialLink } from '../data/site';
import {
  getCollections,
  getVideos,
  selectedVideos,
  summarize,
} from '../lib/content';

const [collections, videos] = await Promise.all([getCollections(), getVideos()]);

const { personality, identity, introduction, experience, software, contact } = siteConfig;
const heroVideo =
  videos.find((v) => v.id === personality.hero.videoSlug) ??
  videos.find((v) => v.data.featured) ??
  videos[0];

const featuredCollections = collections.filter((c) => c.data.featured);
const shownCollections = (featuredCollections.length ? featuredCollections : collections)
  .slice(0, 5)
  .map((c) => summarize(c, videos));

const candidatePicks = selectedVideos(videos);
const picks = (candidatePicks.length > 0 ? candidatePicks : videos).slice(0, 6);
const hasEmail = hasRealContactEmail(contact.email);
const realSocials = contact.socials.filter(isRealSocialLink);
const hasPublishedWork = collections.length > 0 || videos.length > 0;
---

<BaseLayout
  title="Hero Portrait Preview — VUPHM Portfolio"
  description="Preview so sánh biến thể Hero chân dung thật Dark Portrait (Variant A vs Variant B) và Abstract Hero."
  preloadImage="/hero/hero-portrait-b-desktop.webp"
  noindex={true}
>
  <!-- Interactive Floating Comparison Switcher (Apple Product Studio Glass) -->
  <aside class="hero-switcher-dock" aria-label="Hero Variant Switcher">
    <div class="dock-panel glass">
      <span class="dock-label">Hero Studio:</span>
      <div class="dock-buttons">
        <button type="button" class="dock-btn active" data-variant="portrait-b">
          <span class="indicator"></span>
          B — Subtle Rim <span class="badge-rec">Đề xuất</span>
        </button>
        <button type="button" class="dock-btn" data-variant="portrait-a">
          <span class="indicator"></span>
          A — Narrow Light
        </button>
        <button type="button" class="dock-btn" data-variant="abstract">
          <span class="indicator"></span>
          Abstract gốc
        </button>
      </div>
    </div>
  </aside>

  <!-- Hero with default Variant B (Subtle Rim) -->
  <CinematicStage
    video={heroVideo}
    headline={siteConfig.name}
    headlineAccent={siteConfig.role}
    variant="portrait-b"
  />

  {
    shownCollections.length > 0 ? (
      <section class="section section-collections" id="collections" aria-labelledby="collections-title">
        <div class="wrap">
          <div class="section-head reveal">
            <div class="section-intro">
              {personality.collections.eyebrow && (
                <p class="eyebrow">{personality.collections.eyebrow}</p>
              )}
              <h2 class="section-title" id="collections-title">
                {personality.collections.headline}
              </h2>
              {personality.collections.subline && (
                <p class="section-subline">{personality.collections.subline}</p>
              )}
            </div>
            <a class="link-more" href="/works">
              {personality.cta.viewAllCollections}
            </a>
          </div>

          <ul class="collection-grid" role="list">
            {shownCollections.map((summary, i) => (
              <li class:list={['reveal', { wide: i === 0 && shownCollections.length % 2 === 1 }]}>
                <CollectionCard
                  summary={summary}
                  size={i === 0 && shownCollections.length % 2 === 1 ? 'wide' : 'default'}
                />
              </li>
            ))}
          </ul>
        </div>
      </section>
    ) : (
      !hasPublishedWork && (
        <section class="section" id="collections" aria-labelledby="collections-title">
          <div class="wrap">
            <div class="section-head reveal">
              <div class="section-intro">
                {personality.collections.eyebrow && (
                  <p class="eyebrow">{personality.collections.eyebrow}</p>
                )}
                <h2 class="section-title" id="collections-title">
                  {personality.collections.headline}
                </h2>
                {personality.collections.subline && (
                  <p class="section-subline">{personality.collections.subline}</p>
                )}
              </div>
            </div>
            <EmptyState />
          </div>
        </section>
      )
    )
  }

  {
    picks.length > 0 && (
      <section class="section" id="videos" aria-labelledby="videos-title">
        <div class="wrap">
          <div class="section-head reveal">
            <div class="section-intro">
              {personality.selectedVideos.eyebrow && (
                <p class="eyebrow">{personality.selectedVideos.eyebrow}</p>
              )}
              <h2 class="section-title" id="videos-title">
                {personality.selectedVideos.headline}
              </h2>
              {personality.selectedVideos.subline && (
                <p class="section-subline">{personality.selectedVideos.subline}</p>
              )}
            </div>
          </div>
          <EditorialVideoGrid videos={picks} group="selected" defaultPattern="asymmetric" />
        </div>
      </section>
    )
  }

  <!-- Section Giới thiệu (Round 04: Verified Identity & Standardized Software) -->
  <section class="section profile" id="about" aria-labelledby="about-title">
    <div class="wrap">
      <div class="profile-layout">
        <div class="profile-bio reveal">
          <p class="eyebrow">{introduction.headline}</p>
          <h2 class="profile-name" id="about-title">
            <span class="person-full-name">{identity.fullName}</span>
            <span class="brand-tag glass">{identity.brand}</span>
            <span class="profile-role">· {identity.role}</span>
          </h2>
          <p class="profile-lead">
            {introduction.body}
          </p>

          <div class="info-group">
            <h3 class="info-title">{experience.headline}</h3>
            <div class="field-subgroups">
              <div class="field-subgroup">
                <span class="subgroup-label">{experience.contentTypes.label}</span>
                <ul class="pill-list" role="list">
                  {experience.contentTypes.items.map((item) => (
                    <li class="pill-item glass" title={item.keywordEn}>
                      {item.labelVi}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="field-subgroup">
                <span class="subgroup-label">{experience.industries.label}</span>
                <ul class="pill-list" role="list">
                  {experience.industries.items.map((item) => (
                    <li class="pill-item glass" title={item.keywordEn}>
                      {item.labelVi}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div>

        <div class="profile-capabilities reveal">
          <div class="info-group">
            <h3 class="info-title">{software.headline}</h3>

            <!-- Phần mềm chính: CapCut -->
            <div class="software-card software-primary glass">
              <div class="software-icon-wrap primary-icon">
                <img src={software.primary.iconSrc} alt={software.primary.name} class="software-img" width="44" height="44" loading="eager" decoding="async" />
              </div>
              <div class="software-meta">
                <div class="software-name-row">
                  <span class="software-name primary-name">{software.primary.name}</span>
                  <span class="badge badge-primary">{software.primary.badge}</span>
                </div>
                <span class="software-desc">Phần mềm biên tập video chính</span>
              </div>
            </div>

            <!-- Phần mềm bổ trợ: Adobe Premiere Pro & Adobe Photoshop -->
            <div class="software-secondary-grid">
              {software.secondary.map((tool) => (
                <div class="software-card software-secondary glass">
                  <div class="software-icon-wrap secondary-icon">
                    <img src={tool.iconSrc} alt={tool.name} class="software-img" width="32" height="32" loading="eager" decoding="async" />
                  </div>
                  <div class="software-meta">
                    <div class="software-name-row">
                      <span class="software-name">{tool.name}</span>
                      <span class="badge badge-secondary">{tool.badge}</span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section Liên hệ (Round 04: Compact Professional Contact) -->
  <section class="section contact-section" id="contact" aria-labelledby="contact-title">
    <div class="wrap">
      <div class="contact-box glass reveal">
        <div class="contact-head">
          <p class="eyebrow">{contact.headline}</p>
          <h2 class="contact-headline" id="contact-title">Trao đổi dự án</h2>
          {contact.subline && <p class="contact-subline">{contact.subline}</p>}
        </div>

        <div class="contact-body">
          {hasEmail && (
            <Fragment set:html="<!--email_off-->" />
            <a
              class="contact-email-card"
              href={`mailto:${contact.email}`}
              data-event="contact_click"
              data-event-target="contact_email"
              aria-label={`Gửi email đến ${contact.email}`}
            >
              <div class="email-icon-box" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                </svg>
              </div>
              <div class="email-meta">
                <span class="email-label">Email chính</span>
                <span class="email-value">{contact.email}</span>
              </div>
              <span class="email-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 17 17 7M8 7h9v9"></path>
                </svg>
              </span>
            </a>
            <Fragment set:html="<!--/email_off-->" />
          )}

          <div class="contact-secondary-row">
            {contact.zaloUrl && (
              <a
                class="contact-zalo-pill glass"
                href={contact.zaloUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-event="contact_click"
                data-event-target="contact_zalo"
                aria-label="Nhắn tin qua Zalo"
              >
                <img src="/media/zalo.svg" alt="" width="18" height="18" loading="eager" decoding="async" aria-hidden="true" />
                <span>Nhắn tin qua Zalo</span>
              </a>
            )}

            {realSocials.map((s) => (
              <a
                class="contact-social-pill glass"
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                data-event="contact_click"
                data-event-target={`social_${s.label.toLowerCase()}`}
              >
                <span>{s.label}</span>
              </a>
            ))}
          </div>

          <div class="contact-drive-row">
            <GoogleDriveButton sourceContext="contact" />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const dockButtons = document.querySelectorAll('.hero-switcher-dock .dock-btn');
    const heroSection = document.querySelector('.hero-section');
    const posterImg = document.querySelector('.hero-backdrop .master-poster');
    const posterSource = document.querySelector('.hero-backdrop .hero-master-pic source');
    const figureImg = document.querySelector('.hero-backdrop .figure-img');
    const figureSource = document.querySelector('.hero-backdrop .layer-figure source');
    const atmosphereLayers = document.querySelector('.hero-atmosphere-layers');
    const video = document.querySelector('.hero-backdrop video[data-ambient]');

    const switchHero = (variant) => {
      dockButtons.forEach((btn) => {
        btn.classList.toggle('active', btn.dataset.variant === variant);
      });

      if (variant === 'portrait-b') {
        if (posterImg) posterImg.src = '/hero/hero-stage-bg-desktop.webp';
        if (posterSource) posterSource.srcset = '/hero/hero-stage-bg-mobile.webp';
        if (figureImg) figureImg.src = '/hero/hero-figure-b-desktop.webp';
        if (figureSource) figureSource.srcset = '/hero/hero-figure-b-mobile.webp';
        if (heroSection) {
          heroSection.classList.add('is-portrait', 'variant-portrait-b');
          heroSection.classList.remove('variant-portrait-a', 'variant-abstract');
        }
        if (atmosphereLayers) atmosphereLayers.style.display = '';
        if (video) video.pause();
      } else if (variant === 'portrait-a') {
        if (posterImg) posterImg.src = '/hero/hero-stage-bg-desktop.webp';
        if (posterSource) posterSource.srcset = '/hero/hero-stage-bg-mobile.webp';
        if (figureImg) figureImg.src = '/hero/hero-figure-a-desktop.webp';
        if (figureSource) figureSource.srcset = '/hero/hero-figure-a-mobile.webp';
        if (heroSection) {
          heroSection.classList.add('is-portrait', 'variant-portrait-a');
          heroSection.classList.remove('variant-portrait-b', 'variant-abstract');
        }
        if (atmosphereLayers) atmosphereLayers.style.display = '';
        if (video) video.pause();
      } else if (variant === 'abstract') {
        if (posterImg) posterImg.src = '/hero/hero-poster-desktop.webp';
        if (posterSource) posterSource.srcset = '/hero/hero-poster-mobile.webp';
        if (heroSection) {
          heroSection.classList.remove('is-portrait', 'variant-portrait-a', 'variant-portrait-b');
          heroSection.classList.add('variant-abstract');
        }
        if (atmosphereLayers) atmosphereLayers.style.display = 'none';
      }
    };

    dockButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const variant = btn.dataset.variant;
        if (variant) switchHero(variant);
      });
    });

    try {
      const urlParams = new URLSearchParams(window.location.search);
      const heroParam = urlParams.get('hero');
      if (heroParam === 'a' || heroParam === 'narrow') {
        switchHero('portrait-a');
      } else if (heroParam === 'abstract') {
        switchHero('abstract');
      } else if (heroParam === 'b' || heroParam === 'rim') {
        switchHero('portrait-b');
      }
    } catch (_) {}
  })();
</script>

<style>
  .hero-switcher-dock {
    position: fixed;
    top: 76px;
    right: 20px;
    z-index: 1000;
  }

  .dock-panel {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 10px;
    border-radius: 999px;
    background: rgb(15 17 23 / 0.82);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgb(255 255 255 / 0.12);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.5);
  }

  .dock-label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-2, #a1a1a6);
    padding-left: 6px;
  }

  .dock-buttons {
    display: flex;
    gap: 4px;
  }

  .dock-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--fg-2, #a1a1a6);
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .dock-btn:hover {
    color: #fff;
    background: rgb(255 255 255 / 0.06);
  }

  .dock-btn.active {
    color: #fff;
    background: rgb(255 255 255 / 0.14);
    border-color: rgb(255 255 255 / 0.24);
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.3);
  }

  .indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--fg-3, #6e6e73);
    transition: background 0.2s ease;
  }

  .dock-btn.active .indicator {
    background: #34c759;
    box-shadow: 0 0 6px #34c759;
  }

  .badge-rec {
    font-size: 9px;
    font-weight: 600;
    padding: 2px 6px;
    border-radius: 6px;
    background: rgb(52 199 89 / 0.18);
    color: #34c759;
    border: 1px solid rgb(52 199 89 / 0.3);
  }

  /* Grid & Profile Styles synced with Index */
  .section-collections {
    padding-top: clamp(40px, 5.5vw, 76px);
  }

  .collection-grid {
    display: grid;
    gap: var(--gap);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 734px) {
    .collection-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .collection-grid .wide {
      grid-column: 1 / -1;
    }
  }

  .profile {
    padding-block: var(--section) 0;
  }
  .profile-layout {
    display: grid;
    gap: 40px;
    align-items: start;
  }
  @media (min-width: 734px) {
    .profile-layout {
      grid-template-columns: 1.25fr 1fr;
      gap: clamp(40px, 5vw, 80px);
    }
  }

  .profile-name {
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: var(--tracking-snug);
    margin: 8px 0 16px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px 14px;
  }

  .brand-tag {
    font-size: var(--fs-sm);
    font-weight: 600;
    padding: 4px 12px;
    border-radius: var(--r-pill);
    color: var(--fg);
    letter-spacing: 0.02em;
    vertical-align: middle;
  }

  .profile-role {
    font-size: var(--fs-lead);
    color: var(--fg-2);
    font-weight: 400;
  }

  .profile-lead {
    font-size: var(--fs-lead);
    color: var(--fg-2);
    line-height: 1.5;
    letter-spacing: -0.012em;
    margin-bottom: clamp(24px, 3.5vw, 40px);
    max-width: 58ch;
  }

  .info-group {
    display: grid;
    gap: 16px;
  }

  .info-title {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--fg-2);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0;
  }

  .field-subgroups {
    display: grid;
    gap: 16px;
  }

  .field-subgroup {
    display: grid;
    gap: 8px;
  }

  .subgroup-label {
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--fg-3);
  }

  .pill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pill-item {
    font-size: var(--fs-sm);
    padding: 6px 14px;
    border-radius: var(--r-pill);
    color: var(--fg);
    font-weight: 500;
  }

  /* Software Cards */
  .software-primary {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    border-radius: var(--r-lg);
    background: linear-gradient(135deg, rgb(255 255 255 / 0.08), rgb(20 22 28 / 0.7));
    border: 1px solid rgb(255 255 255 / 0.15);
  }

  .software-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-sm);
    flex-shrink: 0;
  }

  .primary-icon {
    width: 48px;
    height: 48px;
  }

  .software-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .software-meta {
    display: grid;
    gap: 4px;
    flex: 1;
  }

  .software-name-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .software-name {
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--fg);
  }

  .primary-name {
    font-size: var(--fs-lead);
  }

  .badge {
    font-size: 0.6875rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: var(--r-pill);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .badge-primary {
    background: rgb(255 255 255 / 0.15);
    color: #fff;
    border: 1px solid rgb(255 255 255 / 0.2);
  }

  .badge-secondary {
    background: rgb(255 255 255 / 0.06);
    color: var(--fg-2);
    border: 1px solid rgb(255 255 255 / 0.1);
  }

  .software-desc {
    font-size: var(--fs-sm);
    color: var(--fg-2);
  }

  .software-secondary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px;
    margin-top: 12px;
  }

  .software-secondary {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-radius: var(--r-md);
  }

  .secondary-icon {
    width: 34px;
    height: 34px;
  }

  /* Contact Section */
  .contact-section {
    padding-block: var(--section);
  }

  .contact-box {
    padding: clamp(32px, 5vw, 64px);
    border-radius: var(--r-xl);
    display: grid;
    gap: 32px;
  }

  .contact-head {
    display: grid;
    gap: 8px;
  }

  .contact-headline {
    font-size: var(--fs-h2);
    font-weight: 600;
    letter-spacing: var(--tracking-snug);
    margin: 0;
  }

  .contact-subline {
    font-size: var(--fs-lead);
    color: var(--fg-2);
    margin: 0;
  }

  .contact-body {
    display: grid;
    gap: 20px;
  }

  .contact-email-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    border-radius: var(--r-lg);
    background: linear-gradient(135deg, rgb(255 255 255 / 0.1), rgb(20 22 28 / 0.8));
    border: 1px solid rgb(255 255 255 / 0.18);
    transition: transform var(--dur-fast) var(--ease-out), border-color var(--dur-fast) ease;
  }

  .contact-email-card:hover {
    transform: translateY(-2px);
    border-color: rgb(220 230 245 / 0.45);
  }

  .email-icon-box {
    width: 44px;
    height: 44px;
    border-radius: var(--r-md);
    background: rgb(255 255 255 / 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
  }

  .email-meta {
    display: grid;
    gap: 2px;
    flex: 1;
  }

  .email-label {
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--fg-3);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .email-value {
    font-size: var(--fs-body);
    font-weight: 600;
    color: #fff;
  }

  .email-arrow {
    color: var(--fg-2);
    transition: transform var(--dur-fast) var(--ease-out), color var(--dur-fast) ease;
  }

  .contact-email-card:hover .email-arrow {
    color: #fff;
    transform: translate(2px, -2px);
  }

  .contact-secondary-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .contact-zalo-pill,
  .contact-social-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
