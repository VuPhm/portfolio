---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CollectionCard from '../../components/CollectionCard.astro';
import VideoGrid from '../../components/VideoGrid.astro';
import EmptyState from '../../components/EmptyState.astro';
import GoogleDriveButton from '../../components/GoogleDriveButton.astro';
import { siteConfig } from '../../data/site';
import {
  getCollections,
  getVideos,
  standaloneVideos,
  summarize,
  KIND_LABEL,
  type CollectionKind,
} from '../../lib/content';

const [collections, videos] = await Promise.all([getCollections(), getVideos()]);
const summaries = collections.map((c) => summarize(c, videos));
const standalone = standaloneVideos(videos);
const hasAnyWork = summaries.length > 0 || videos.length > 0;

const presentKinds = new Set<CollectionKind>(collections.map((c) => c.data.kind));
const filterOptions: Array<{ id: string; label: string }> = [
  { id: 'all', label: 'Tất cả' },
  ...(['series', 'channel', 'brand'] as const)
    .filter((k) => presentKinds.has(k))
    .map((k) => ({ id: k, label: KIND_LABEL[k].many })),
  ...(standalone.length > 0 ? [{ id: 'standalone', label: 'Độc lập' }] : []),
];
---

<BaseLayout title={`Tác phẩm — ${siteConfig.siteTitle}`}>
  <div class="page wrap">
    <header class="page-head">
      <div class="title-block">
        <h1>Tác phẩm</h1>
        <p class="page-subline">{siteConfig.personality.collections.headline}</p>
      </div>
      {
        filterOptions.length > 2 && (
          <div class="filters glass" role="tablist" aria-label="Lọc tác phẩm">
            {filterOptions.map((opt, idx) => (
              <button
                type="button"
                role="tab"
                class="filter-btn"
                aria-selected={idx === 0 ? 'true' : 'false'}
                data-filter={opt.id}
              >
                {opt.label}
              </button>
            ))}
          </div>
        )
      }
    </header>

    {
      !hasAnyWork && (
        <section class="work-block" aria-label="Archive status">
          <EmptyState />
        </section>
      )
    }

    {
      summaries.length > 0 && (
        <section class="work-block" data-collections-section aria-labelledby="work-collections">
          <div class="section-head">
            <h2 class="section-title" id="work-collections">Bộ sưu tập</h2>
          </div>
          <ul class="collection-grid" role="list">
            {summaries.map((summary, i) => (
              <li class="reveal" data-kind={summary.entry.data.kind}>
                <CollectionCard summary={summary} eager={i < 2} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      videos.length > 0 && (
        <section class="work-block" data-videos-section aria-labelledby="work-videos">
          <div class="section-head">
            <h2 class="section-title" id="work-videos">Tất cả video</h2>
          </div>
          <VideoGrid videos={videos} group="works-all" showOrientationSwitch={false} />
        </section>
      )
    }

    <GoogleDriveButton sourceContext="works" />
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: calc(var(--nav-h) + clamp(48px, 7vw, 96px));
  }

  .page-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
    margin-bottom: clamp(40px, 6vw, 72px);
  }

  .title-block {
    display: grid;
    gap: 6px;
  }

  h1 {
    font-size: var(--fs-h1);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: var(--tracking-tight);
  }

  .page-subline {
    font-size: var(--fs-lead);
    color: var(--fg-2);
    letter-spacing: -0.015em;
  }

  .filters {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    max-width: 100%;
    padding: 4px;
    border-radius: var(--r-pill);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .filters::-webkit-scrollbar {
    display: none;
  }

  .filter-btn {
    flex: none;
    height: 34px;
    padding: 0 11px;
    border: 0;
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--fg-2);
    font-family: inherit;
    font-size: 0.8125rem;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color var(--dur-fast) ease,
      background-color var(--dur-fast) ease;
  }
  @media (min-width: 600px) {
    .filters {
      gap: 4px;
      padding: 5px;
    }
    .filter-btn {
      height: 36px;
      padding: 0 16px;
      font-size: var(--fs-sm);
    }
  }

  .filter-btn:hover {
    color: var(--fg);
  }

  .filter-btn[aria-selected='true'] {
    color: var(--fg);
    background: rgb(255 255 255 / 0.12);
  }

  .work-block + .work-block {
    margin-top: var(--section);
  }

  .collection-grid {
    display: grid;
    gap: var(--gap);
    list-style: none;
    margin: 0;
    padding: 0;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr));
  }

  li[hidden],
  .work-block[hidden] {
    display: none;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const collectionSection = document.querySelector<HTMLElement>('[data-collections-section]');
  const collectionItems = document.querySelectorAll<HTMLElement>('[data-collections-section] li[data-kind]');
  const videoSection = document.querySelector<HTMLElement>('[data-videos-section]');
  const videoGrid = videoSection?.querySelector<HTMLElement>('[data-video-grid]');
  const videoItems = document.querySelectorAll<HTMLElement>('[data-videos-section] li[data-kinds]');
  const videoGroups = document.querySelectorAll<HTMLElement>('[data-videos-section] .group');

  function applyFilter(filter: string) {
    for (const btn of buttons) {
      btn.setAttribute('aria-selected', String(btn.dataset.filter === filter));
    }

    if (collectionSection) {
      let visibleCollections = 0;
      for (const item of collectionItems) {
        const show = filter === 'all' || item.dataset.kind === filter;
        item.hidden = !show;
        if (show) visibleCollections++;
      }
      collectionSection.hidden = visibleCollections === 0;
    }

    for (const item of videoItems) {
      const kinds = (item.dataset.kinds ?? '').split(/\s+/).filter(Boolean);
      const show = filter === 'all' || kinds.includes(filter);
      if (show) {
        item.removeAttribute('data-filter-hidden');
      } else {
        item.setAttribute('data-filter-hidden', 'true');
      }
    }

    let anyVideoGroupVisible = false;
    for (const group of videoGroups) {
      const hasVisible = group.querySelector('li:not([data-filter-hidden="true"])') !== null;
      group.hidden = !hasVisible;
      if (hasVisible) anyVideoGroupVisible = true;
    }
    if (videoSection) {
      videoSection.hidden = !anyVideoGroupVisible;
    }

    videoGrid?.dispatchEvent(new CustomEvent('portfolio:filter-change'));
  }

  for (const btn of buttons) {
    btn.addEventListener('click', () => {
      applyFilter(btn.dataset.filter ?? 'all');
    });
  }
</script>
