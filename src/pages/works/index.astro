---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CollectionCard from '../../components/CollectionCard.astro';
import VideoCard from '../../components/VideoCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import GoogleDriveButton from '../../components/GoogleDriveButton.astro';
import CampaignShowcase from '../../components/CampaignShowcase.astro';
import { siteConfig } from '../../data/site';
import {
  getCollections,
  getVideos,
  getCollectionKinds,
  videoKinds,
  standaloneVideos,
  summarize,
  KIND_LABEL,
  type CollectionKind,
  type VideoItem,
} from '../../lib/content';

const [collections, videos, kindsMap] = await Promise.all([
  getCollections(),
  getVideos(),
  getCollectionKinds(),
]);
const summaries = collections.map((c) => summarize(c, videos));
const standalone = standaloneVideos(videos);
const hasAnyWork = summaries.length > 0 || videos.length > 0;

// Resolve year per video (from video metadata or collection metadata)
const collectionYearMap = new Map(collections.map((c) => [c.id, c.data.year]));

function resolveVideoYear(video: VideoItem): string | undefined {
  if (video.data.year) return video.data.year;
  for (const ref of video.data.collections) {
    const cy = collectionYearMap.get(ref.id);
    if (cy) return cy;
  }
  return undefined;
}

// Group videos by year descending
const yearBuckets = new Map<string, VideoItem[]>();
const unclassifiedVideos: VideoItem[] = [];

for (const video of videos) {
  const y = resolveVideoYear(video);
  if (y) {
    const list = yearBuckets.get(y) || [];
    list.push(video);
    yearBuckets.set(y, list);
  } else {
    unclassifiedVideos.push(video);
  }
}

const sortedYears = Array.from(yearBuckets.keys()).sort((a, b) => b.localeCompare(a));
const yearGroups = sortedYears.map((year) => ({
  id: year,
  title: year,
  videos: yearBuckets.get(year)!,
}));

if (unclassifiedVideos.length > 0) {
  yearGroups.push({
    id: 'featured',
    title: 'Tác phẩm tuyển chọn',
    videos: unclassifiedVideos,
  });
}

const presentKinds = new Set<CollectionKind>(collections.map((c) => c.data.kind));
const filterOptions: Array<{ id: string; label: string }> = [
  { id: 'all', label: 'Tất cả' },
  ...(['series', 'channel', 'brand'] as const)
    .filter((k) => presentKinds.has(k))
    .map((k) => ({ id: k, label: KIND_LABEL[k].many })),
  ...(standalone.length > 0 ? [{ id: 'standalone', label: 'Độc lập' }] : []),
];
---

<BaseLayout title={`Tác phẩm — ${siteConfig.siteTitle}`}>
  <div class="page wrap">
    <header class="page-head">
      <div class="title-block">
        <h1>Tác phẩm</h1>
        <p class="page-subline">{siteConfig.personality.collections.headline}</p>
      </div>
      {
        filterOptions.length > 2 && (
          <div class="filters glass" role="tablist" aria-label="Lọc tác phẩm">
            {filterOptions.map((opt, idx) => (
              <button
                type="button"
                role="tab"
                class="filter-btn"
                aria-selected={idx === 0 ? 'true' : 'false'}
                data-filter={opt.id}
              >
                {opt.label}
              </button>
            ))}
          </div>
        )
      }
    </header>

    {
      !hasAnyWork && (
        <section class="work-block" aria-label="Archive status">
          <EmptyState />
        </section>
      )
    }

    {
      summaries.length > 0 && (
        <section class="work-block" data-collections-section aria-labelledby="work-collections">
          <div class="section-head">
            <h2 class="section-title" id="work-collections">Bộ sưu tập</h2>
          </div>
          <ul class="collection-grid" role="list">
            {summaries.map((summary, i) => (
              <li class="reveal" data-kind={summary.entry.data.kind}>
                <CollectionCard summary={summary} eager={i < 2} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {/* Section B: All Works — Grouped by Year Descending */}
    {
      yearGroups.length > 0 && (
        <section class="work-block" data-videos-section aria-labelledby="work-videos">
          <div class="section-head">
            <h2 class="section-title" id="work-videos">Tất cả video</h2>
          </div>

          <div class="year-groups-container">
            {yearGroups.map((group) => (
              <div class="year-group-block" data-year-group={group.id}>
                <div class="year-header reveal">
                  <div class="year-title-row">
                    <h3 class="year-heading">{group.title}</h3>
                    <span class="year-count-badge glass">{group.videos.length} video</span>
                  </div>
                  <div class="year-hairline" aria-hidden="true" />
                </div>

                <ul class="works-mixed-grid" role="list">
                  {group.videos.map((video) => (
                    <li
                      class:list={[
                        'works-grid-item',
                        'reveal',
                        video.data.orientation === 'landscape' ? 'span-landscape' : 'span-portrait',
                      ]}
                      data-kinds={videoKinds(video, kindsMap)}
                      data-orientation={video.data.orientation}
                    >
                      <VideoCard video={video} group={`works-${group.id}`} />
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      )
    }

    {/* Section D: Future Brand / Campaign Showcase (Preview Mode Only) */}
    {
      siteConfig.demoPreview && (
        <section class="work-block preview-campaign-block" aria-label="Brand & Campaign Architecture Preview">
          <div class="section-head">
            <div class="section-intro">
              <p class="eyebrow">Kiến trúc tương lai (Preview)</p>
              <h2 class="section-title">Brand & Campaign Hierarchy</h2>
            </div>
          </div>
          <CampaignShowcase />
        </section>
      )
    }

    <GoogleDriveButton sourceContext="works" />
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: calc(var(--nav-h) + clamp(48px, 7vw, 96px));
  }

  .page-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
    margin-bottom: clamp(40px, 6vw, 72px);
  }

  .title-block {
    display: grid;
    gap: 6px;
  }

  h1 {
    font-size: var(--fs-h1);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: var(--tracking-tight);
  }

  .page-subline {
    font-size: var(--fs-lead);
    color: var(--fg-2);
    letter-spacing: -0.015em;
  }

  .filters {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    max-width: 100%;
    padding: 4px;
    border-radius: var(--r-pill);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .filters::-webkit-scrollbar {
    display: none;
  }

  .filter-btn {
    flex: none;
    height: 34px;
    padding: 0 11px;
    border: 0;
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--fg-2);
    font-family: inherit;
    font-size: 0.8125rem;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color var(--dur-fast) ease,
      background-color var(--dur-fast) ease;
  }
  @media (min-width: 600px) {
    .filters {
      gap: 4px;
      padding: 5px;
    }
    .filter-btn {
      height: 36px;
      padding: 0 16px;
      font-size: var(--fs-sm);
    }
  }

  .filter-btn:hover {
    color: var(--fg);
  }

  .filter-btn[aria-selected='true'] {
    color: var(--fg);
    background: rgb(255 255 255 / 0.12);
  }

  .work-block + .work-block {
    margin-top: var(--section);
  }

  .collection-grid {
    display: grid;
    gap: var(--gap);
    list-style: none;
    margin: 0;
    padding: 0;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr));
  }

  /* Year Grouping Styling */
  .year-groups-container {
    display: grid;
    gap: clamp(48px, 6vw, 80px);
  }

  .year-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: clamp(16px, 2.5vw, 24px);
  }

  .year-title-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-shrink: 0;
  }

  .year-heading {
    font-size: clamp(1.375rem, 2.5vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin: 0;
  }

  .year-count-badge {
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--fg-3);
    padding: 2px 8px;
    border-radius: var(--r-pill);
    font-variant-numeric: tabular-nums;
  }

  .year-hairline {
    flex: 1;
    height: 1px;
    background: var(--hairline);
  }

  /* High Density Mixed-Aspect Grid */
  .works-mixed-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--gap);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 600px) {
    .works-mixed-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 960px) {
    .works-mixed-grid {
      grid-template-columns: repeat(4, 1fr);
    }
    .span-landscape {
      grid-column: span 2;
    }
  }

  @media (min-width: 1280px) {
    .works-mixed-grid {
      grid-template-columns: repeat(5, 1fr);
    }
    .span-landscape {
      grid-column: span 2;
    }
  }

  .works-grid-item {
    min-width: 0;
  }

  .preview-campaign-block {
    margin-top: calc(var(--section) * 1.2);
  }

  li[hidden],
  .work-block[hidden],
  .year-group-block[hidden] {
    display: none;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const collectionSection = document.querySelector<HTMLElement>('[data-collections-section]');
  const collectionItems = document.querySelectorAll<HTMLElement>('[data-collections-section] li[data-kind]');
  const videoSection = document.querySelector<HTMLElement>('[data-videos-section]');
  const videoItems = document.querySelectorAll<HTMLElement>('[data-videos-section] li[data-kinds]');
  const yearGroupBlocks = document.querySelectorAll<HTMLElement>('[data-videos-section] .year-group-block');

  function applyFilter(filter: string) {
    for (const btn of buttons) {
      btn.setAttribute('aria-selected', String(btn.dataset.filter === filter));
    }

    if (collectionSection) {
      let visibleCollections = 0;
      for (const item of collectionItems) {
        const show = filter === 'all' || item.dataset.kind === filter;
        item.hidden = !show;
        if (show) visibleCollections++;
      }
      collectionSection.hidden = visibleCollections === 0;
    }

    for (const item of videoItems) {
      const kinds = (item.dataset.kinds ?? '').split(/\s+/).filter(Boolean);
      const show = filter === 'all' || kinds.includes(filter);
      item.hidden = !show;
    }

    let anyGroupVisible = false;
    for (const grp of yearGroupBlocks) {
      const hasVisible = grp.querySelector('li:not([hidden])') !== null;
      grp.hidden = !hasVisible;
      if (hasVisible) anyGroupVisible = true;
    }

    if (videoSection) {
      videoSection.hidden = !anyGroupVisible;
    }
  }

  for (const btn of buttons) {
    btn.addEventListener('click', () => {
      applyFilter(btn.dataset.filter ?? 'all');
    });
  }
</script>
