---
import BaseLayout from '../layouts/BaseLayout.astro';
import CinematicStage from '../components/CinematicStage.astro';
import CollectionCard from '../components/CollectionCard.astro';
import EditorialVideoGrid from '../components/EditorialVideoGrid.astro';
import EmptyState from '../components/EmptyState.astro';
import GoogleDriveButton from '../components/GoogleDriveButton.astro';
import { siteConfig, hasRealContactEmail, isRealSocialLink } from '../data/site';
import {
  getCollections,
  getVideos,
  selectedVideos,
  summarize,
} from '../lib/content';

const [collections, videos] = await Promise.all([getCollections(), getVideos()]);

const { personality, identity, introduction, experience, software, contact } = siteConfig;
const heroVideo =
  videos.find((v) => v.id === personality.hero.videoSlug) ??
  videos.find((v) => v.data.featured) ??
  videos[0];

const featuredCollections = collections.filter((c) => c.data.featured);
const shownCollections = (featuredCollections.length ? featuredCollections : collections)
  .slice(0, 5)
  .map((c) => summarize(c, videos));

const candidatePicks = selectedVideos(videos);
const picks = (candidatePicks.length > 0 ? candidatePicks : videos).slice(0, 6);
const hasEmail = hasRealContactEmail(contact.email);
const realSocials = contact.socials.filter(isRealSocialLink);
const hasPublishedWork = collections.length > 0 || videos.length > 0;
---

<BaseLayout preloadImage="/hero/hero-portrait-b-desktop.webp">
  <CinematicStage
    video={heroVideo}
    headline={siteConfig.name}
    headlineAccent={siteConfig.role}
    variant="portrait-b"
  />

  {
    shownCollections.length > 0 ? (
      <section class="section section-collections" id="collections" aria-labelledby="collections-title">
        <div class="wrap">
          <div class="section-head reveal">
            <div class="section-intro">
              {personality.collections.eyebrow && (
                <p class="eyebrow">{personality.collections.eyebrow}</p>
              )}
              <h2 class="section-title" id="collections-title">
                {personality.collections.headline}
              </h2>
              {personality.collections.subline && (
                <p class="section-subline">{personality.collections.subline}</p>
              )}
            </div>
            <a class="link-more" href="/works">
              {personality.cta.viewAllCollections}
            </a>
          </div>

          <ul class="collection-grid" role="list">
            {shownCollections.map((summary, i) => (
              <li class:list={['reveal', { wide: i === 0 && shownCollections.length % 2 === 1 }]}>
                <CollectionCard
                  summary={summary}
                  size={i === 0 && shownCollections.length % 2 === 1 ? 'wide' : 'default'}
                />
              </li>
            ))}
          </ul>
        </div>
      </section>
    ) : (
      !hasPublishedWork && (
        <section class="section" id="collections" aria-labelledby="collections-title">
          <div class="wrap">
            <div class="section-head reveal">
              <div class="section-intro">
                {personality.collections.eyebrow && (
                  <p class="eyebrow">{personality.collections.eyebrow}</p>
                )}
                <h2 class="section-title" id="collections-title">
                  {personality.collections.headline}
                </h2>
                {personality.collections.subline && (
                  <p class="section-subline">{personality.collections.subline}</p>
                )}
              </div>
            </div>
            <EmptyState />
          </div>
        </section>
      )
    )
  }

  {
    picks.length > 0 && (
      <section class="section" id="videos" aria-labelledby="videos-title">
        <div class="wrap">
          <div class="section-head reveal">
            <div class="section-intro">
              {personality.selectedVideos.eyebrow && (
                <p class="eyebrow">{personality.selectedVideos.eyebrow}</p>
              )}
              <h2 class="section-title" id="videos-title">
                {personality.selectedVideos.headline}
              </h2>
              {personality.selectedVideos.subline && (
                <p class="section-subline">{personality.selectedVideos.subline}</p>
              )}
            </div>
          </div>
          <EditorialVideoGrid videos={picks} group="selected" defaultPattern="asymmetric" />
        </div>
      </section>
    )
  }

  <!-- Section Giới thiệu (Round 04: Verified Identity & Standardized Software) -->
  <section class="section profile" id="about" aria-labelledby="about-title">
    <div class="wrap">
      <div class="profile-layout">
        <div class="profile-bio reveal">
          <p class="eyebrow">{introduction.headline}</p>
          <h2 class="profile-name" id="about-title">
            <span class="person-full-name">{identity.fullName}</span>
            <span class="brand-tag glass">{identity.brand}</span>
            <span class="profile-role">· {identity.role}</span>
          </h2>
          <p class="profile-lead">
            {introduction.body}
          </p>

          <div class="info-group">
            <h3 class="info-title">{experience.headline}</h3>
            <div class="field-subgroups">
              <div class="field-subgroup">
                <span class="subgroup-label">{experience.contentTypes.label}</span>
                <ul class="pill-list" role="list">
                  {experience.contentTypes.items.map((item) => (
                    <li class="pill-item glass" title={item.keywordEn}>
                      {item.labelVi}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="field-subgroup">
                <span class="subgroup-label">{experience.industries.label}</span>
                <ul class="pill-list" role="list">
                  {experience.industries.items.map((item) => (
                    <li class="pill-item glass" title={item.keywordEn}>
                      {item.labelVi}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div>

        <div class="profile-capabilities reveal">
          <div class="info-group">
            <h3 class="info-title">{software.headline}</h3>

            <!-- Phần mềm chính: CapCut -->
            <div class="software-card software-primary glass">
              <div class="software-icon-wrap primary-icon">
                <img src={software.primary.iconSrc} alt={software.primary.name} class="software-img" width="44" height="44" loading="eager" decoding="async" />
              </div>
              <div class="software-meta">
                <div class="software-name-row">
                  <span class="software-name primary-name">{software.primary.name}</span>
                  <span class="badge badge-primary">{software.primary.badge}</span>
                </div>
                <span class="software-desc">Phần mềm biên tập video chính</span>
              </div>
            </div>

            <!-- Phần mềm bổ trợ: Adobe Premiere Pro & Adobe Photoshop -->
            <div class="software-secondary-grid">
              {software.secondary.map((tool) => (
                <div class="software-card software-secondary glass">
                  <div class="software-icon-wrap secondary-icon">
                    <img src={tool.iconSrc} alt={tool.name} class="software-img" width="32" height="32" loading="eager" decoding="async" />
                  </div>
                  <div class="software-meta">
                    <div class="software-name-row">
                      <span class="software-name">{tool.name}</span>
                      <span class="badge badge-secondary">{tool.badge}</span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section Liên hệ (Round 03.7 & 03.8: Compact Professional Contact) -->
  <section class="section contact-section" id="contact" aria-labelledby="contact-title">
    <div class="wrap">
      <div class="contact-box glass reveal">
        <div class="contact-head">
          <p class="eyebrow">{contact.headline}</p>
          <h2 class="contact-headline" id="contact-title">Trao đổi dự án</h2>
          {contact.subline && <p class="contact-subline">{contact.subline}</p>}
        </div>

        <div class="contact-body">
          <!-- 1. Email — Primary Action (prominent card with icon & mailto) -->
          {hasEmail && (
            <Fragment set:html="<!--email_off-->" />
            <a
              class="contact-email-card"
              href={`mailto:${contact.email}`}
              data-event="contact_click"
              data-event-target="contact_email"
              aria-label={`Gửi email đến ${contact.email}`}
            >
              <div class="email-icon-box" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                </svg>
              </div>
              <div class="email-meta">
                <span class="email-label">Email chính</span>
                <span class="email-value">{contact.email}</span>
              </div>
              <span class="email-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 17 17 7M8 7h9v9"></path>
                </svg>
              </span>
            </a>
            <Fragment set:html="<!--/email_off-->" />
          )}

          <!-- 2. Zalo & Socials (Secondary Row) -->
          <div class="contact-secondary-row">
            {contact.zaloUrl && (
              <a
                class="contact-zalo-pill glass"
                href={contact.zaloUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-event="contact_click"
                data-event-target="contact_zalo"
                aria-label="Nhắn tin qua Zalo"
              >
                <img src="/media/zalo.svg" alt="" width="18" height="18" loading="eager" decoding="async" aria-hidden="true" />
                <span>Nhắn tin qua Zalo</span>
              </a>
            )}

            {realSocials.map((s) => (
              <a
                class="contact-social-pill glass"
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                data-event="contact_click"
                data-event-target={`social_${s.label.toLowerCase()}`}
              >
                <span>{s.label}</span>
              </a>
            ))}
          </div>

          <div class="contact-drive-row">
            <GoogleDriveButton sourceContext="contact" />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section-collections {
    padding-top: clamp(40px, 5.5vw, 76px);
  }

  .collection-grid {
    display: grid;
    gap: var(--gap);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 734px) {
    .collection-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .collection-grid .wide {
      grid-column: 1 / -1;
    }
  }

  /* Profile & About Section */
  .profile {
    padding-block: var(--section) 0;
  }
  .profile-layout {
    display: grid;
    gap: 40px;
    align-items: start;
  }
  @media (min-width: 734px) {
    .profile-layout {
      grid-template-columns: 1.25fr 1fr;
      gap: clamp(40px, 5vw, 80px);
    }
  }

  .profile-name {
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: var(--tracking-snug);
    margin: 8px 0 16px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 12px;
  }
  .person-full-name {
    color: var(--fg);
  }
  .brand-tag {
    font-size: var(--fs-xs);
    font-weight: 600;
    padding: 3px 10px;
    border-radius: var(--r-pill);
    letter-spacing: 0.04em;
    color: var(--fg-2);
    vertical-align: middle;
  }
  .profile-role {
    color: var(--fg-2);
    font-weight: 500;
  }
  .profile-lead {
    font-size: var(--fs-lead);
    line-height: 1.45;
    color: var(--fg-2);
    letter-spacing: -0.015em;
    max-width: 42ch;
    text-wrap: pretty;
  }

  .info-group {
    margin-top: 32px;
    display: grid;
    gap: 14px;
  }
  .profile-capabilities > .info-group:first-child {
    margin-top: 0;
  }
  .info-title {
    font-size: var(--fs-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--fg-3);
  }

  .field-subgroups {
    display: grid;
    gap: 16px;
  }
  .field-subgroup {
    display: grid;
    gap: 8px;
  }
  .subgroup-label {
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--fg-3);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .pill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pill-item {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--fg);
    padding: 8px 16px;
    border-radius: var(--r-pill);
    letter-spacing: -0.01em;
  }

  /* Software Cards */
  .software-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    border-radius: var(--r-md);
    transition: transform var(--dur-fast) var(--ease-out), background-color var(--dur-fast) ease;
  }
  .software-primary {
    padding: 20px 24px;
    border: 1px solid rgb(255 255 255 / 0.16);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.08), rgb(255 255 255 / 0.02) 60%), rgb(30 30 32 / 0.65);
  }
  .software-primary:hover {
    transform: translateY(-2px);
    border-color: rgb(255 255 255 / 0.28);
  }

  .software-secondary-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  @media (min-width: 600px) {
    .software-secondary-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .software-secondary {
    padding: 14px 18px;
  }
  .software-secondary:hover {
    transform: translateY(-1px);
    border-color: rgb(255 255 255 / 0.2);
  }

  .software-icon-wrap {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-xs);
    overflow: hidden;
  }
  .primary-icon {
    width: 44px;
    height: 44px;
  }
  .secondary-icon {
    width: 32px;
    height: 32px;
  }
  .software-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .software-meta {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .software-name-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .software-name {
    font-size: var(--fs-body);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--fg);
    white-space: nowrap;
  }
  .primary-name {
    font-size: 1.125rem;
  }
  .software-desc {
    font-size: var(--fs-sm);
    color: var(--fg-2);
  }

  .badge {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px 8px;
    border-radius: var(--r-pill);
    white-space: nowrap;
  }
  .badge-primary {
    background: rgb(255 255 255 / 0.16);
    color: #fff;
    border: 1px solid rgb(255 255 255 / 0.24);
  }
  .badge-secondary {
    background: rgb(255 255 255 / 0.06);
    color: var(--fg-2);
    border: 1px solid var(--hairline);
  }

  /* Compact Contact Section — Round 03.7 & 03.8 */
  .contact-section {
    padding-block: var(--section) var(--section);
  }
  .contact-box {
    width: 100%;
    max-width: 600px;
    margin-inline: auto;
    padding: clamp(28px, 4.5vw, 44px);
    border-radius: var(--r-xl);
    display: grid;
    gap: 28px;
    text-align: center;
    box-sizing: border-box;
  }
  .contact-head {
    display: grid;
    gap: 8px;
    justify-items: center;
  }
  .contact-headline {
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: var(--tracking-snug);
    margin: 0;
  }
  .contact-subline {
    font-size: var(--fs-sm);
    color: var(--fg-2);
    line-height: 1.45;
    max-width: 42ch;
    margin: 0;
  }

  .contact-body {
    display: grid;
    gap: 16px;
    width: 100%;
  }

  /* Primary Email Card — Guaranteed Single Line on Mobile */
  .contact-email-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 22px;
    border-radius: var(--r-md);
    text-decoration: none;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.12), rgb(255 255 255 / 0.04) 60%), rgb(28 28 32 / 0.7);
    border: 1px solid rgb(255 255 255 / 0.2);
    box-shadow: 0 4px 20px rgb(0 0 0 / 0.25);
    transition: transform var(--dur-fast) var(--ease-out), border-color var(--dur-fast) ease, background-color var(--dur-fast) ease;
    text-align: left;
    width: 100%;
    box-sizing: border-box;
  }
  .contact-email-card:hover {
    transform: translateY(-2px);
    border-color: rgb(255 255 255 / 0.35);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.18), rgb(255 255 255 / 0.06) 60%), rgb(34 34 38 / 0.8);
  }
  .contact-email-card:active {
    transform: scale(0.985);
  }

  .email-icon-box {
    width: 42px;
    height: 42px;
    border-radius: var(--r-pill);
    background: rgb(255 255 255 / 0.1);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 1px solid rgb(255 255 255 / 0.16);
  }
  .email-meta {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .email-label {
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--fg-3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .email-value {
    font-size: clamp(1rem, 2.2vw, 1.25rem);
    font-weight: 600;
    color: var(--fg);
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .email-arrow {
    color: var(--fg-3);
    display: flex;
    align-items: center;
    flex-shrink: 0;
    transition: transform var(--dur-fast) ease, color var(--dur-fast) ease;
  }
  .contact-email-card:hover .email-arrow {
    color: #fff;
    transform: translate(2px, -2px);
  }

  @media (max-width: 520px) {
    .contact-box {
      padding: 24px 16px;
      gap: 20px;
    }
    .contact-email-card {
      padding: 12px 14px;
      gap: 12px;
    }
    .email-icon-box {
      display: none;
    }
    .email-value {
      font-size: clamp(0.875rem, 4.4vw, 1.0625rem);
      white-space: nowrap;
    }
    .email-label {
      font-size: 0.6875rem;
    }
  }

  /* Secondary Row: Zalo & Socials */
  .contact-secondary-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  .contact-zalo-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: var(--r-pill);
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--fg);
    text-decoration: none;
    transition: transform var(--dur-fast) var(--ease-out), border-color var(--dur-fast) ease;
  }
  .contact-zalo-pill:hover {
    transform: translateY(-1px);
    border-color: rgb(255 255 255 / 0.28);
  }
  .contact-zalo-pill:active {
    transform: scale(0.98);
  }

  .contact-social-pill {
    display: inline-flex;
    align-items: center;
    padding: 10px 18px;
    border-radius: var(--r-pill);
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--fg-2);
    text-decoration: none;
    transition: transform var(--dur-fast) var(--ease-out), color var(--dur-fast) ease;
  }
  .contact-social-pill:hover {
    color: var(--fg);
    transform: translateY(-1px);
  }

  .contact-drive-row {
    display: flex;
    justify-content: center;
    margin-top: 4px;
  }
</style>
