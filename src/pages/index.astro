---
import BaseLayout from '../layouts/BaseLayout.astro';
import CinematicStage from '../components/CinematicStage.astro';
import CollectionCard from '../components/CollectionCard.astro';
import VideoGrid from '../components/VideoGrid.astro';
import ScrollStory from '../components/ScrollStory.astro';
import EmptyState from '../components/EmptyState.astro';
import GoogleDriveButton from '../components/GoogleDriveButton.astro';
import { siteConfig, hasRealContactEmail, isRealSocialLink } from '../data/site';
import {
  getCollections,
  getVideos,
  selectedVideos,
  summarize,
  buildSiteStats,
} from '../lib/content';

const [collections, videos] = await Promise.all([getCollections(), getVideos()]);

const { personality, identity, introduction, experience, software, contact } = siteConfig;
const heroVideo =
  videos.find((v) => v.id === personality.hero.videoSlug) ??
  videos.find((v) => v.data.featured) ??
  videos[0];

const featuredCollections = collections.filter((c) => c.data.featured);
const shownCollections = (featuredCollections.length ? featuredCollections : collections)
  .slice(0, 5)
  .map((c) => summarize(c, videos));

const candidatePicks = selectedVideos(videos);
const picks = (candidatePicks.length > 0 ? candidatePicks : videos).slice(0, 6);
const stats = buildSiteStats(collections, videos);
const hasEmail = hasRealContactEmail(contact.email);
const realSocials = contact.socials.filter(isRealSocialLink);
const hasPublishedWork = collections.length > 0 || videos.length > 0;
---

<BaseLayout preloadImage="/hero/hero-poster-desktop.webp">
  <CinematicStage
    video={heroVideo}
    headline={siteConfig.name}
    headlineAccent={siteConfig.role}
    subline={personality.hero.subline}
  />

  {
    shownCollections.length > 0 ? (
      <section class="section" id="collections" aria-labelledby="collections-title">
        <div class="wrap">
          <div class="section-head reveal">
            <div class="section-intro">
              {personality.collections.eyebrow && (
                <p class="eyebrow">{personality.collections.eyebrow}</p>
              )}
              <h2 class="section-title" id="collections-title">
                {personality.collections.headline}
              </h2>
              {personality.collections.subline && (
                <p class="section-subline">{personality.collections.subline}</p>
              )}
            </div>
            <a class="link-more" href="/works">
              {personality.cta.viewAllCollections}
            </a>
          </div>

          <ul class="collection-grid" role="list">
            {shownCollections.map((summary, i) => (
              <li class:list={['reveal', { wide: i === 0 && shownCollections.length % 2 === 1 }]}>
                <CollectionCard
                  summary={summary}
                  size={i === 0 && shownCollections.length % 2 === 1 ? 'wide' : 'default'}
                />
              </li>
            ))}
          </ul>
        </div>
      </section>
    ) : (
      !hasPublishedWork && (
        <section class="section" id="collections" aria-labelledby="collections-title">
          <div class="wrap">
            <div class="section-head reveal">
              <div class="section-intro">
                {personality.collections.eyebrow && (
                  <p class="eyebrow">{personality.collections.eyebrow}</p>
                )}
                <h2 class="section-title" id="collections-title">
                  {personality.collections.headline}
                </h2>
                {personality.collections.subline && (
                  <p class="section-subline">{personality.collections.subline}</p>
                )}
              </div>
            </div>
            <EmptyState />
          </div>
        </section>
      )
    )
  }

  <ScrollStory config={siteConfig.scrollStory} />

  {
    picks.length > 0 && (
      <section class="section" id={!shownCollections.length ? 'collections' : undefined} aria-labelledby="videos-title">
        <div class="wrap">
          <div class="section-head reveal">
            <div class="section-intro">
              {personality.selectedVideos.eyebrow && (
                <p class="eyebrow">{personality.selectedVideos.eyebrow}</p>
              )}
              <h2 class="section-title" id="videos-title">
                {personality.selectedVideos.headline}
              </h2>
              {personality.selectedVideos.subline && (
                <p class="section-subline">{personality.selectedVideos.subline}</p>
              )}
            </div>
          </div>
          <VideoGrid videos={picks} group="selected" layout="feature" />
        </div>
      </section>
    )
  }

  {
    stats.length > 0 && (
      <section class="section" aria-label="Portfolio statistics">
        <div class="wrap">
          <ul class="stats-strip reveal" role="list">
            {stats.map((stat) => (
              <li class="stat-item">
                <div class="stat-value-row">
                  <span class="stat-value">{stat.value}</span>
                  {stat.note && <span class="stat-badge">{stat.note}</span>}
                </div>
                <span class="stat-label">{stat.label}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Section Giới thiệu (Round 03.6: Verified Identity & Standardized Software) -->
  <section class="section profile" id="about" aria-labelledby="about-title">
    <div class="wrap">
      <div class="profile-layout">
        <div class="profile-bio reveal">
          <p class="eyebrow">{introduction.headline}</p>
          <h2 class="profile-name" id="about-title">
            <span class="person-full-name">{identity.fullName}</span>
            <span class="brand-tag glass">{identity.brand}</span>
            <span class="profile-role">· {identity.role}</span>
          </h2>
          <p class="profile-lead">
            {introduction.body}
          </p>

          <div class="info-group">
            <h3 class="info-title">{experience.headline}</h3>
            <div class="field-subgroups">
              <div class="field-subgroup">
                <span class="subgroup-label">{experience.contentTypes.label}</span>
                <ul class="pill-list" role="list">
                  {experience.contentTypes.items.map((item) => (
                    <li class="pill-item glass" title={item.keywordEn}>
                      {item.labelVi}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="field-subgroup">
                <span class="subgroup-label">{experience.industries.label}</span>
                <ul class="pill-list" role="list">
                  {experience.industries.items.map((item) => (
                    <li class="pill-item glass" title={item.keywordEn}>
                      {item.labelVi}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div>

        <div class="profile-capabilities reveal">
          <div class="info-group">
            <h3 class="info-title">{software.headline}</h3>

            <!-- Phần mềm chính: CapCut -->
            <div class="software-card software-primary glass">
              <div class="software-icon-wrap primary-icon">
                <img src={software.primary.iconSrc} alt={software.primary.name} class="software-img" width="36" height="36" loading="lazy" />
              </div>
              <div class="software-meta">
                <div class="software-name-row">
                  <span class="software-name primary-name">{software.primary.name}</span>
                  <span class="badge badge-primary">{software.primary.badge}</span>
                </div>
                <span class="software-desc">Phần mềm biên tập video chính</span>
              </div>
            </div>

            <!-- Phần mềm bổ trợ: Adobe Premiere Pro & Adobe Photoshop -->
            <div class="software-secondary-grid">
              {software.secondary.map((tool) => (
                <div class="software-card software-secondary glass">
                  <div class="software-icon-wrap secondary-icon">
                    <img src={tool.iconSrc} alt={tool.name} class="software-img" width="28" height="28" loading="lazy" />
                  </div>
                  <div class="software-meta">
                    <div class="software-name-row">
                      <span class="software-name">{tool.name}</span>
                      <span class="badge badge-secondary">{tool.badge}</span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section Liên hệ (Round 03.6: Email, Phone & Zalo) -->
  <section class="section contact-section" id="contact" aria-labelledby="contact-title">
    <div class="wrap">
      <div class="contact-card glass reveal">
        <div class="contact-head">
          <p class="eyebrow">{personality.contact.eyebrow}</p>
          <h2 class="contact-headline" id="contact-title">{contact.headline}</h2>
          {contact.subline && <p class="contact-subline">{contact.subline}</p>}
          <div class="contact-person-meta">
            <span class="person-name">{identity.fullName}</span>
            <span class="person-role">({identity.brand} · {identity.role})</span>
          </div>
        </div>

        <div class="contact-body">
          <div class="contact-channels">
            <!-- 1. Email -->
            {hasEmail && (
              <a
                class="contact-channel-item glass"
                href={`mailto:${contact.email}`}
                data-event="contact_click"
                data-event-target="contact_email"
                aria-label={`Gửi email đến ${contact.email}`}
              >
                <div class="channel-icon-wrap icon-email">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                  </svg>
                </div>
                <div class="channel-meta">
                  <span class="channel-label">Email</span>
                  <span class="channel-value">{contact.email}</span>
                </div>
                <span class="channel-action">Gửi thư ›</span>
              </a>
            )}

            <!-- 2. Điện thoại -->
            {contact.phoneE164 && (
              <a
                class="contact-channel-item glass"
                href={`tel:${contact.phoneE164}`}
                data-event="contact_click"
                data-event-target="contact_phone"
                aria-label={`Gọi điện thoại đến ${contact.phoneDisplay}`}
              >
                <div class="channel-icon-wrap icon-phone">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                  </svg>
                </div>
                <div class="channel-meta">
                  <span class="channel-label">Điện thoại</span>
                  <span class="channel-value">{contact.phoneDisplay}</span>
                </div>
                <span class="channel-action">Gọi ngay ›</span>
              </a>
            )}

            <!-- 3. Zalo -->
            {contact.zaloUrl && (
              <a
                class="contact-channel-item glass"
                href={contact.zaloUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-event="contact_click"
                data-event-target="contact_zalo"
                aria-label="Nhắn tin qua Zalo (mở trong tab mới)"
              >
                <div class="channel-icon-wrap icon-zalo">
                  <img src="/media/zalo.svg" alt="Zalo" width="22" height="22" loading="lazy" />
                </div>
                <div class="channel-meta">
                  <span class="channel-label">Zalo</span>
                  <span class="channel-value">{contact.phoneDisplay}</span>
                </div>
                <span class="channel-action">Nhắn Zalo ›</span>
              </a>
            )}
          </div>

          <GoogleDriveButton sourceContext="contact" />

          {realSocials.length > 0 && (
            <ul class="socials" role="list">
              {realSocials.map((s) => (
                <li>
                  <a
                    href={s.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-event="contact_click"
                    data-event-target={`social_${s.label.toLowerCase()}`}
                  >
                    {s.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .collection-grid {
    display: grid;
    gap: var(--gap);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 734px) {
    .collection-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .collection-grid .wide {
      grid-column: 1 / -1;
    }
  }

  /* Profile & About Section */
  .profile {
    padding-block: clamp(60px, 9vw, 120px) 0;
  }
  .profile-layout {
    display: grid;
    gap: 48px;
    align-items: start;
  }
  @media (min-width: 960px) {
    .profile-layout {
      grid-template-columns: 1.25fr 1fr;
      gap: 80px;
    }
  }

  .profile-name {
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: var(--tracking-snug);
    margin: 8px 0 16px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 12px;
  }
  .person-full-name {
    color: var(--fg);
  }
  .brand-tag {
    font-size: var(--fs-xs);
    font-weight: 600;
    padding: 3px 10px;
    border-radius: var(--r-pill);
    letter-spacing: 0.04em;
    color: var(--fg-2);
    vertical-align: middle;
  }
  .profile-role {
    color: var(--fg-2);
    font-weight: 500;
  }
  .profile-lead {
    font-size: var(--fs-lead);
    line-height: 1.45;
    color: var(--fg-2);
    letter-spacing: -0.015em;
    max-width: 42ch;
    text-wrap: pretty;
  }

  .info-group {
    margin-top: 32px;
    display: grid;
    gap: 14px;
  }
  .info-title {
    font-size: var(--fs-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--fg-3);
  }

  .field-subgroups {
    display: grid;
    gap: 16px;
  }
  .field-subgroup {
    display: grid;
    gap: 8px;
  }
  .subgroup-label {
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--fg-3);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .pill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pill-item {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--fg);
    padding: 8px 16px;
    border-radius: var(--r-pill);
    letter-spacing: -0.01em;
  }

  /* Software Cards */
  .software-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    border-radius: var(--r-md);
    transition: transform var(--dur-fast) var(--ease-out), background-color var(--dur-fast) ease;
  }
  .software-primary {
    padding: 20px 24px;
    border: 1px solid rgb(255 255 255 / 0.16);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.08), rgb(255 255 255 / 0.02) 60%), rgb(30 30 32 / 0.65);
  }
  .software-primary:hover {
    transform: translateY(-2px);
    border-color: rgb(255 255 255 / 0.28);
  }

  .software-secondary-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  @media (min-width: 600px) {
    .software-secondary-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .software-secondary {
    padding: 14px 18px;
  }
  .software-secondary:hover {
    transform: translateY(-1px);
    border-color: rgb(255 255 255 / 0.2);
  }

  .software-icon-wrap {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-xs);
    overflow: hidden;
  }
  .primary-icon {
    width: 44px;
    height: 44px;
    background: #000;
    padding: 4px;
    border: 1px solid var(--hairline);
  }
  .secondary-icon {
    width: 34px;
    height: 34px;
  }
  .software-img {
    display: block;
    object-fit: contain;
  }

  .software-meta {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .software-name-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .software-name {
    font-size: var(--fs-body);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--fg);
    white-space: nowrap;
  }
  .primary-name {
    font-size: 1.125rem;
  }
  .software-desc {
    font-size: var(--fs-sm);
    color: var(--fg-2);
  }

  .badge {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px 8px;
    border-radius: var(--r-pill);
  }
  .badge-primary {
    background: rgb(255 255 255 / 0.16);
    color: #fff;
    border: 1px solid rgb(255 255 255 / 0.24);
  }
  .badge-secondary {
    background: rgb(255 255 255 / 0.06);
    color: var(--fg-2);
    border: 1px solid var(--hairline);
  }

  /* Contact Section */
  .contact-section {
    padding-block: clamp(60px, 9vw, 120px) var(--section);
  }
  .contact-card {
    padding: clamp(28px, 4vw, 56px);
    border-radius: var(--r-lg);
    display: grid;
    gap: 36px;
  }
  @media (min-width: 960px) {
    .contact-card {
      grid-template-columns: 1fr 1.2fr;
      align-items: start;
      gap: 56px;
    }
  }

  .contact-headline {
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: var(--tracking-snug);
    margin: 8px 0 12px;
  }
  .contact-subline {
    font-size: var(--fs-body);
    color: var(--fg-2);
    line-height: 1.45;
    max-width: 38ch;
  }
  .contact-person-meta {
    margin-top: 18px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px;
    font-size: var(--fs-sm);
  }
  .person-name {
    font-weight: 600;
    color: var(--fg);
  }
  .person-role {
    color: var(--fg-3);
  }

  .contact-body {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: stretch;
  }

  /* Contact Channels */
  .contact-channels {
    display: grid;
    gap: 12px;
    width: 100%;
  }
  .contact-channel-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 20px;
    border-radius: var(--r-md);
    text-decoration: none;
    transition: transform var(--dur-fast) var(--ease-out), background-color var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }
  .contact-channel-item:hover {
    transform: translateY(-2px);
    border-color: rgb(255 255 255 / 0.24);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.14), rgb(255 255 255 / 0.04) 55%), rgb(36 36 38 / 0.65);
  }
  .contact-channel-item:active {
    transform: scale(0.985);
  }

  .channel-icon-wrap {
    width: 40px;
    height: 40px;
    border-radius: var(--r-pill);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .icon-email {
    background: rgb(255 255 255 / 0.08);
    color: var(--fg);
    border: 1px solid var(--hairline);
  }
  .icon-phone {
    background: rgb(52 199 89 / 0.15);
    color: #34c759;
    border: 1px solid rgb(52 199 89 / 0.25);
  }
  .icon-zalo {
    background: rgb(0 104 255 / 0.15);
    border: 1px solid rgb(0 104 255 / 0.25);
  }

  .channel-meta {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .channel-label {
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--fg-3);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .channel-value {
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--fg);
    letter-spacing: -0.01em;
    word-break: break-word;
  }

  .channel-action {
    font-size: var(--fs-sm);
    color: var(--fg-2);
    white-space: nowrap;
    transition: color var(--dur-fast) ease, transform var(--dur-fast) ease;
  }
  .contact-channel-item:hover .channel-action {
    color: #fff;
    transform: translateX(2px);
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-sm);
    color: var(--fg-3);
  }
  .socials a {
    transition: color var(--dur-fast) ease;
  }
  .socials a:hover {
    color: var(--fg);
  }
</style>
