---
/**
 * Shared Google Drive Product Library Link Button — Round 03.4C / 03.5
 * Apple-inspired Liquid Glass button with official Google Drive logo & external link icon.
 */
import { siteConfig } from '../data/site';

interface Props {
  class?: string;
  sourceContext?: string;
}

const {
  class: className = '',
  sourceContext = 'portfolio',
} = Astro.props;

const DRIVE_URL = siteConfig.contact.driveFolderUrl;
const DRIVE_LABEL = siteConfig.contact.driveLabel;
---

<div class:list={['external-library-wrap', className]}>
  <a
    class="external-library-link glass"
    href={DRIVE_URL}
    target="_blank"
    rel="noopener noreferrer"
    data-event="external_library_click"
    data-event-target={`google_drive_${sourceContext}`}
    aria-label={`${DRIVE_LABEL} (mở trong tab mới)`}
  >
    <svg class="icon-drive" viewBox="0 0 87.3 78" width="18" height="16" aria-hidden="true">
      <path d="m6.6 66.85 3.85 6.65c.8 1.4 1.95 2.5 3.3 3.3l13.75-23.8h-27.5c0 1.55.4 3.1 1.2 4.5z" fill="#0066da"/>
      <path d="m43.65 25-13.75-23.8c-1.35.8-2.5 1.9-3.3 3.3l-25.4 44a9.06 9.06 0 0 0 -1.2 4.5h27.5z" fill="#00ac47"/>
      <path d="m73.55 76.8c1.35-.8 2.5-1.9 3.3-3.3l1.6-2.75 7.65-13.25c.8-1.4 1.2-2.95 1.2-4.5h-27.502l5.852 11.5z" fill="#ea4335"/>
      <path d="m43.65 25 13.75-23.8c-1.35-.8-2.9-1.2-4.5-1.2h-18.5c-1.6 0-3.15.45-4.5 1.2z" fill="#00832d"/>
      <path d="m59.8 53h-32.3l-13.75 23.8c1.35.8 2.9 1.2 4.5 1.2h50.8c1.6 0 3.15-.45 4.5-1.2z" fill="#2684fc"/>
      <path d="m73.4 26.5-12.7-22c-.8-1.4-1.95-2.5-3.3-3.3l-13.75 23.8 16.15 28h27.45c0-1.55-.4-3.1-1.2-4.5z" fill="#ffba00"/>
    </svg>
    <span class="label">{DRIVE_LABEL}</span>
    <svg class="icon-ext" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M7 17 17 7M8 7h9v9"></path>
    </svg>
  </a>
</div>

<style>
  .external-library-wrap {
    display: flex;
    justify-content: flex-start;
    margin-top: 24px;
    margin-bottom: 8px;
  }
  .external-library-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 12px 22px;
    border-radius: var(--r-pill);
    font-size: var(--fs-body);
    font-weight: 500;
    color: var(--fg);
    transition: transform var(--dur-fast) var(--ease-out), background-color var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }
  .external-library-link:hover {
    color: #fff;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.16), rgb(255 255 255 / 0.05) 55%), rgb(40 40 44 / 0.7);
    border-color: rgb(255 255 255 / 0.22);
  }
  .external-library-link:active {
    transform: scale(0.98);
  }
  .icon-drive {
    flex-shrink: 0;
  }
  .icon-ext {
    width: 16px;
    height: 16px;
    opacity: 0.7;
    margin-left: 2px;
    transition: transform var(--dur-fast) ease, opacity var(--dur-fast) ease;
  }
  .external-library-link:hover .icon-ext {
    opacity: 1;
    transform: translate(2px, -2px);
  }
  .label {
    letter-spacing: -0.01em;
  }
</style>
