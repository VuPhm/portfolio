---
/**
 * Inline player for the video page. Never shows a play control unless a real source exists.
 *  - file          → native <video controls>, metadata preload only, explicit width/height, poster loaded first
 *  - youtube/vimeo → poster facade; the iframe loads only after the user presses play
 *  - external/none → poster
 */
import type { VideoItem } from '../lib/content';
import { resolveVideoPlayback } from '../lib/media';

interface Props {
  video: VideoItem;
}

const { video } = Astro.props;
const d = video.data;
const source = resolveVideoPlayback(d);
const isRatio45 = d.aspectRatio === '4:5';
const portrait = d.orientation === 'portrait';
const [w, h] = isRatio45 ? [1080, 1350] : portrait ? [900, 1600] : [1600, 900];
---

<div
  class:list={['player-frame', 'media', isRatio45 ? 'ratio-4-5' : portrait ? 'portrait' : 'landscape']}
  style={`view-transition-name: video-${video.id}`}
>
  {
    source.type === 'file' ? (
      <video
        controls
        playsinline
        preload="metadata"
        width={w}
        height={h}
        poster={d.poster.src}
      >
        {source.webm && <source src={source.webm} type="video/webm" />}
        <source src={source.src} type="video/mp4" />
        {source.fallbackSrc && <source src={source.fallbackSrc} type="video/mp4" />}
        {d.captionsUrl && <track kind="captions" src={d.captionsUrl} srclang="en" label="Captions" />}
      </video>
    ) : (
      <img
        src={d.poster.src}
        alt={d.poster.alt || d.title}
        width={w}
        height={h}
        fetchpriority="high"
        decoding="async"
      />
    )
  }
  {
    (source.type === 'youtube' || source.type === 'vimeo') && (
      <button class="glass play" type="button" data-embed={source.embed} data-title={d.title} aria-label={`Phát ${d.title}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z" fill="currentColor" />
        </svg>
      </button>
    )
  }
</div>

<style>
  .player-frame {
    --r: var(--r-lg);
    margin-inline: auto;
    box-shadow: 0 40px 100px rgb(0 0 0 / 0.55);
  }
  .landscape {
    aspect-ratio: 16 / 9;
    width: min(100%, 1280px, calc((100svh - 200px) * 16 / 9));
  }
  .portrait {
    aspect-ratio: 9 / 16;
    width: min(100%, 440px, calc((100svh - 180px) * 9 / 16));
    --r: var(--r-md);
  }
  .ratio-4-5 {
    aspect-ratio: 4 / 5;
    width: min(100%, 600px, calc((100svh - 180px) * 4 / 5));
    --r: var(--r-md);
  }
  video {
    object-fit: contain !important;
    background: #000;
  }
  .player-frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 3;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    color: var(--fg);
    cursor: pointer;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .play svg {
    width: 30px;
    height: 30px;
    margin-left: 4px;
  }
  .play:hover {
    transform: scale(1.06);
  }
  .play:active {
    transform: scale(0.95);
  }
</style>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.player-frame [data-embed]')) {
    btn.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = btn.dataset.embed!;
      iframe.title = btn.dataset.title ?? 'Video';
      iframe.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media';
      iframe.allowFullscreen = true;
      const frame = btn.parentElement!;
      frame.querySelector('img')?.remove();
      btn.replaceWith(iframe);
      iframe.focus();
    });
  }
</script>
