---
import { siteConfig } from '../data/site';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const links = [
  { href: '/works', label: 'Tác phẩm', active: currentPath.startsWith('/works') || currentPath.startsWith('/collections') || currentPath.startsWith('/videos') },
  { href: '/#about', label: 'Giới thiệu', active: false },
  { href: '/#contact', label: 'Liên hệ', active: false },
];
---

<header class="nav-shell">
  <nav class="nav" aria-label="Điều hướng chính">
    <a href="/" class="brand" aria-current={currentPath === '/' ? 'page' : undefined}>
      {siteConfig.name}
    </a>
    <ul>
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={link.active ? 'page' : undefined}
              data-event={link.href === '/#contact' ? 'contact_click' : undefined}
              data-event-target={link.href === '/#contact' ? 'nav' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script is:inline>
  (() => {
    const shell = document.querySelector('.nav-shell');
    if (!shell) return;
    const onScroll = () => {
      shell.classList.toggle('is-scrolled', window.scrollY > 48);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>

<style>
  .nav-shell {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    display: flex;
    justify-content: center;
    width: 100%;
    padding: max(22px, env(safe-area-inset-top)) clamp(24px, 5.5vw, 72px) 0;
    pointer-events: none;
    view-transition-name: site-nav;
    transition:
      padding var(--dur-normal) ease,
      background-color var(--dur-normal) ease,
      border-color var(--dur-normal) ease,
      backdrop-filter var(--dur-normal) ease;
  }

  .nav-shell.is-scrolled {
    padding-top: max(14px, env(safe-area-inset-top));
    padding-bottom: 14px;
    background: rgb(6 7 10 / 0.88);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }

  .nav {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 1440px;
    height: 44px;
  }

  .brand {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: #f5f5f7;
    white-space: nowrap;
    text-decoration: none;
    transition: opacity var(--dur-fast) ease;
  }

  .brand:hover {
    opacity: 0.82;
  }

  ul {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.8vw, 36px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  ul a {
    display: inline-flex;
    align-items: center;
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: #a1a1a6;
    text-decoration: none;
    transition: color var(--dur-fast) ease;
  }

  ul a:hover,
  ul a[aria-current='page'] {
    color: #f5f5f7;
  }

  @media (max-width: 480px) {
    .nav-shell {
      padding: max(16px, env(safe-area-inset-top)) clamp(16px, 4vw, 24px) 0;
    }
    .nav-shell.is-scrolled {
      padding-top: max(12px, env(safe-area-inset-top));
      padding-bottom: 12px;
    }
    ul {
      gap: 16px;
    }
    ul a {
      font-size: 0.8125rem;
    }
  }
</style>
